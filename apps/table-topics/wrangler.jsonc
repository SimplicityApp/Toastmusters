{
  // Cloudflare Worker for the Table Topics generator (docs/TABLE_TOPICS.md).
  // Deployed independently of the timer Worker:
  //   dev : npm run cf:deploy:tabletopics:dev   (from the repo root)
  //   prod: npm run cf:deploy:tabletopics:prod
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "toastmusters-tabletopics",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // Static Assets: the pre-rendered site from scripts/build.mjs.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /topics/travel-places -> /topics/travel-places/index.html etc.
    "html_handling": "auto-trailing-slash",
    // Misses reach the Worker so it can answer with a real 404 status.
    "not_found_handling": "none",
    // Needed for the apex -> www redirect and the security headers.
    "run_worker_first": true
  },

  // ── Production ────────────────────────────────────────────────────────────
  // The site lives at www.toastmusters.com/tabletopics (served through the
  // timer Worker's TABLETOPICS binding). These hosts only redirect there now:
  // the Worker 301s each URL to ROOT_ORIGIN/tabletopics/<same path>. `vars`
  // are not inherited by environments; dev has no path-based host yet, so it
  // leaves ROOT_ORIGIN unset and keeps serving the site on its own hosts.
  "vars": { "ROOT_ORIGIN": "https://www.toastmusters.com" },

  "routes": [
    { "pattern": "tabletopics.toastmusters.com", "custom_domain": true },
    { "pattern": "www.tabletopics.toastmusters.com", "custom_domain": true }
  ],

  "env": {
    // ── Dev / preview: deploy with `--env dev` ──────────────────────────────
    "dev": {
      "routes": [
        { "pattern": "tabletopics-dev.toastmusters.com", "custom_domain": true },
        { "pattern": "www.tabletopics-dev.toastmusters.com", "custom_domain": true }
      ]
    }
  }
  // No secrets: the site is fully static. PostHog's public key is baked in at build time.
}
