# Local secrets for `wrangler dev` — copy to .dev.vars and fill in.
# .dev.vars is gitignored. In production these are set via `wrangler secret put`.

ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Public project key (phc_…). Server-side capture from the Zoom webhook and web
# sign-in (worker/posthog.js), and the release flags (POST /flags in
# worker/flags.js). Leave it empty and every flag
# is at its checked-in fallback, which is off.
POSTHOG_API_KEY=
# Release flags (docs/FEATURE_FLAGS.md). `npm run cf:dev` runs without --env dev,
# so it reads the production block, where FLAGS_FORCE is "" and PostHog is
# asked. With no key above, that hides everything behind the `pro` flag (billing,
# web sign-in, clubs). "1" turns every flag on, "0" turns every flag off, and empty
# asks PostHog. A value here overrides wrangler.jsonc.
FLAGS_FORCE=1
# Personal API key (phx_…) with "Query read" scope, for /api/stats.
# Create at https://us.posthog.com/settings/user-api-keys — the project key
# above cannot run queries.
POSTHOG_QUERY_API_KEY=
# HMAC key for /api/profile and /api/assets session tokens. Generate with
# `openssl rand -base64 32`. Not ZOOM_CLIENT_SECRET on purpose: that one is a
# Zoom credential and the two should rotate independently.
SESSION_SIGNING_KEY=
# Stripe, test mode. Prices must exist with lookup keys pro_monthly / pro_yearly.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (`stripe listen --forward-to localhost:8787/api/stripe/webhook`
# prints one for local dev).
STRIPE_WEBHOOK_SECRET=
